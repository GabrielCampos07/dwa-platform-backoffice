# Optional: pre-fill internal API key in login form (dev only — never commit real secrets)
# NG_APP_INTERNAL_API_KEY=dev-internal-api-key-change-me-min-16-chars

# Optional default tenant/product scope (overridden by context bar + sessionStorage)
# NG_APP_TENANT_ID=dwa
# NG_APP_PRODUCT_ID=academia

# Optional platform-api base URL (production). Dev uses proxy /platform → :3010
# NG_APP_PLATFORM_API_URL=https://api.example.com/platform/v1
